    "spec": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "description": "Google's stock price over time.",
      "data": {
        "url": "data/stocks.csv"
      },
      "transform": [
        {
          "filter": "datum.symbol==='GOOG'"
        }
      ],
      "mark": "line",
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "price",
          "type": "quantitative"
        }
      }
    }
